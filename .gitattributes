# Keep line endings stable on every platform. CI re-runs the importer and checks that
# the derived files are byte-identical, so generated data and sources must stay LF.
* text=auto eol=lf

data/sources/** text eol=lf
data/reports/** text eol=lf
src/data/** text eol=lf
data/derived/wiki-source/** text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

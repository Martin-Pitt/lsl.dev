---
/**
 * Internal: Starlight's Aside markup (`<aside class="starlight-aside starlight-aside--<base>">`) with
 * an inline SVG icon and a kind class, shared by Caveat, Gotcha, Experimental, Performance and the callout form of
 * Limit, so they pick up the same global aside styles (asides.css). Not exported.
 */
import { asideIcons } from './icons';

interface Props { kind: 'caveat' | 'limit' | 'gotcha' | 'performance' | 'experimental'; base: 'note' | 'tip' | 'caution' | 'danger'; title: string; id?: string }
const { kind, base, title, id } = Astro.props;
---
<aside aria-label={title} class={`starlight-aside starlight-aside--${base} au-aside au-aside--${kind}`} id={id}><p class="starlight-aside__title" aria-hidden="true"><Fragment set:html={asideIcons[kind]} />{title}</p><div class="starlight-aside__content"><slot /></div></aside>

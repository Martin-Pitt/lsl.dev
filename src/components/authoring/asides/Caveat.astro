---
/**
 * <Caveat>: a "Caveat" callout, rendered as Starlight Aside markup (base type `note`) with its own icon.
 *
 *   <Caveat>Body in **Markdown**.</Caveat>
 *   <Caveat title="Custom title">…</Caveat>
 */
import AsideBox from './AsideBox.astro';

interface Props { title?: string }
const { title = 'Caveat' } = Astro.props;
---
<AsideBox kind="caveat" base="note" title={title}><slot /></AsideBox>

---
/**
 * <Figure>: a local image in a framed <figure>, with an optional caption (a prop, or Markdown
 * children) and a small hint above the frame. `alt` is required (alt="" only for a purely
 * decorative image). A remote or unknown src fails the build.
 *
 *   <Figure src="~/assets/door-linkset.png" alt="Door linkset in edit mode" caption="The root prim is highlighted yellow." />
 *   <Figure src="~/assets/door-linkset.png" alt="…">Caption with **Markdown**.</Figure>
 *
 * A string src is a path under src/ (`~/…` or `/src/…`); an imported image (src={img}) also works.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata | string; alt: string; caption?: string; hint?: string; width?: number }
const { src, alt, caption, hint, width } = Astro.props;
if (typeof alt !== 'string') throw new Error('<Figure>: the alt prop is required (alt="" for a decorative image)');
const images = import.meta.glob<{ default: ImageMetadata }>('/src/**/*.{png,jpg,jpeg,webp,avif,gif,svg}');
let image: ImageMetadata;
if (typeof src === 'string') {
	if (/^([a-z]+:)?\/\//i.test(src)) throw new Error(`<Figure>: remote images are not allowed (${src}); add the image to the repository`);
	const load = images[src.replace(/^~\//, '/src/')];
	if (!load) throw new Error(`<Figure>: no image at ${src} (a string src is a path under src/, like ~/assets/x.png)`);
	image = (await load()).default;
} else image = src;
const hasCaption = !!caption || Astro.slots.has('default');
---
<figure class="au-figure">{hint && <p class="au-figure__hint">{hint}</p>}<div class="au-figure__frame"><Image src={image} alt={alt} width={width} /></div>{hasCaption && <figcaption>{caption}<slot /></figcaption>}</figure>

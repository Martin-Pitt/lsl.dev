---
/**
 * <Gotcha>: a "Gotcha" callout, rendered as Starlight Aside markup (base type `caution`) with its own icon.
 *
 *   <Gotcha>Body in **Markdown**.</Gotcha>
 *   <Gotcha title="Custom title">…</Gotcha>
 */
import AsideBox from './AsideBox.astro';

interface Props { title?: string }
const { title = 'Gotcha' } = Astro.props;
---
<AsideBox kind="gotcha" base="caution" title={title}><slot /></AsideBox>

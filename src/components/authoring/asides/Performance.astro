---
/**
 * <Performance>: a "Performance" callout, rendered as Starlight Aside markup (base type `tip`) with its own icon.
 *
 *   <Performance>Body in **Markdown**.</Performance>
 *   <Performance title="Custom title">…</Performance>
 */
import AsideBox from './AsideBox.astro';

interface Props { title?: string }
const { title = 'Performance' } = Astro.props;
---
<AsideBox kind="performance" base="tip" title={title}><slot /></AsideBox>

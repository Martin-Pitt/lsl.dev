---
/**
 * One parameter of a user-defined function in a guide, written LSL style: type first.
 *   <Param type="key" name="target">Avatar to follow.</Param>
 * Inside <FunctionSignature> it is one indented code line of the signature followed by its explanation row;
 * on its own (or in <Params>) it is a "type name" entry with the description below.
 * Markup either way: a one-entry <dl> (the "type name" code in <dt>, the description in <dd>), so
 * the explanation stays associated with its parameter. "deprecated" is text, not colour alone.
 * LSL has no optional parameters or default values, so there is no `required` or `default`:
 * say in the description which value to pass for the usual behaviour.
 */
import { typeLabel } from './typeLabel';
interface Props { type: string; name: string; deprecated?: boolean }
const { type, name, deprecated = false } = Astro.props;
const typeHtml = await typeLabel(type);
---
<dl class:list={['au-param', { 'au-param--deprecated': deprecated }]} data-au-type={type} data-au-name={name}>
	<dt>
		<span class="au-param-code"><Fragment set:html={typeHtml} /> <code class="au-param-name">{deprecated ? <del>{name}</del> : name}</code><span class="au-param-comma">,</span></span>
		{deprecated && <span class="au-param-badge">deprecated</span>}
	</dt>
	<dd><slot /></dd>
</dl>

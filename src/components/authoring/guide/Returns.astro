---
/**
 * The return value of a user-defined function in a guide.
 *   <Returns type="integer">TRUE if the target was found.</Returns>
 * Inside <FunctionSignature>, `type` can be left out (the signature's `returns` is shown in the code) and
 * the explanation row sits right under the signature's first line.
 */
import { typeLabel } from './typeLabel';
interface Props { type?: string }
const { type } = Astro.props;
const typeHtml = type ? await typeLabel(type) : '';
---
<dl class="au-param au-returns">
	<dt><span class="au-returns-label">Returns</span>{typeHtml && <> <span class="au-returns-type"><Fragment set:html={typeHtml} /></span></>}</dt>
	<dd><slot /></dd>
</dl>

---
/**
 * Per-page script of the media batch, rendered once at the end of every page (../PageEnd.astro).
 * <Compare>: marks each comparison [data-js] (stacked mode) and copies its range value into --pos
 * (one delegated input listener). Without it the two images stay side by side.
 */
---
<script is:inline>(()=>{const s=f=>{const r=f.querySelector('input');f.style.setProperty('--pos',r.value+'%');r.setAttribute('aria-valuetext',r.value+'% '+r.dataset.before)};document.querySelectorAll('.au-compare').forEach(f=>{f.dataset.js='';s(f)});addEventListener('input',e=>{const f=e.target.closest?.('.au-compare');f&&s(f)})})()</script>

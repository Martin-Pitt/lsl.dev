---
/**
 * Summary at the top of a recipe: how many scripts and roughly how long it takes, as a compact row of
 * small labelled chips (a <dl>, one <div> per fact). No JS.
 * Prims are shown by <Linkset>, and permissions by <Requires>, so they aren't repeated here.
 */
import { onlyProps } from './vocab';

interface Props { scripts?: number; time?: string }
onlyProps(Astro.props, ['scripts', 'time'], 'RecipeMeta');
const { scripts = 1, time } = Astro.props;
---
<dl class="au-recipe-meta">
	<div><dt>Scripts</dt><dd>{scripts}</dd></div>
	{time && <div><dt>Time</dt><dd>{time}</dd></div>}
</dl>

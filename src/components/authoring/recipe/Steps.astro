---
/**
 * Starlight Steps, plus <BuildStep> support: BuildStep items are gathered into the single <ol>
 * that Starlight's Steps requires. A plain Markdown ordered list passes through unchanged.
 * Mixing BuildSteps with other content (a paragraph before the first step, say) fails the build:
 * an <ol> may only hold list items.
 */
import { Steps as StarlightSteps } from '@astrojs/starlight/components';
import { fromHtml } from 'hast-util-from-html';

let html = (await Astro.slots.render('default')).trim();
if (!html.startsWith('<ol') && html.includes('class="au-build-step"')) {
	const stray = fromHtml(html, { fragment: true }).children.find((n: any) => !(n.type === 'element' && n.tagName === 'li') && !(n.type === 'text' && !n.value.trim()) && n.type !== 'comment');
	if (stray) throw new Error(`<Steps>: only <BuildStep> items may go inside; move the other content out (found ${stray.type === 'element' ? `<${(stray as any).tagName}>` : `text "${String((stray as any).value).trim().slice(0, 40)}"`})`);
	html = `<ol>${html}</ol>`;
}
---
<StarlightSteps><Fragment set:html={html} /></StarlightSteps>

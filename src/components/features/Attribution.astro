---
// <Attribution title="Combat Log" page="Combat_Log" /> or with children for custom text.
// CC BY-SA 3.0 credit line for content adapted from the Second Life Wiki. `page` is the wiki page
// name as in its URL; the link is a plain external link (never fetched).
import './features.css';
interface Props { title?: string; page?: string; what?: string }
const { title, page, what = 'Adapted from the Second Life Wiki page' } = Astro.props;
---
<p class="feature-attribution">
	{Astro.slots.has('default') ? <slot /> : <>{what} <a href={`https://wiki.secondlife.com/wiki/${page}`} rel="external">{title}</a>, by Second Life Wiki contributors,</>}
	{' '}under <a href="https://creativecommons.org/licenses/by-sa/3.0/" rel="external">CC BY-SA 3.0</a>.
</p>

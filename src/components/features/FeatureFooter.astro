---
// <FeatureFooter related={["physics"]} categories={["combat"]} archive={["Category:LSL Combat2"]} />
// Related feature pages, the definition categories this feature is home to (also read by the
// sidebar, category and reference pages), and background pages on the live Second Life Wiki
// (`archive` takes wiki page titles; links are plain external links, never fetched).
import { categoryMap, categoryHref, wikiByTitle } from '../../lib/catalog';
import { featurePageMap, featureHref } from '../../lib/features';
interface Props { related?: string[]; categories?: string[]; archive?: string[] }
const { related = [], categories = [], archive = [] } = Astro.props;
function need<T>(v: T | undefined, what: string): T { if (!v) throw new Error(`<FeatureFooter>: unknown ${what}`); return v; }
const rel = related.map(id => need(featurePageMap.get(id), `feature "${id}"`));
const cats = categories.map(id => need(categoryMap.get(id), `category "${id}"`));
const wiki = archive.map(t => need(wikiByTitle.get(t), `archive page "${t}"`));
import './features.css';
---
<footer class="feature-footer not-content">
	{rel.length > 0 && <div><h2 id="related-features">Related features</h2><ul class="inline-links">{rel.map(f => <li><a href={featureHref(f.id)}>{f.title}</a></li>)}</ul></div>}
	{cats.length > 0 && <div><h2 id="categories">Categories</h2><ul class="inline-links">{cats.map(c => <li><a href={categoryHref(c.id)}>{c.label}</a> <small>({c.functions.length + c.events.length})</small></li>)}</ul></div>}
	{wiki.length > 0 && <div><h2 id="background">On the Second Life Wiki</h2><ul class="inline-links">{wiki.map(w => <li><a href={w.source.url} rel="external">{w.title.replace(/^Category:/, '')}</a></li>)}</ul></div>}
</footer>
<style>
	.feature-footer { margin-top: 1rem; border-top: 1px solid var(--sl-color-hairline); display: grid; gap: 0 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
	.feature-footer h2 { font-size: var(--sl-text-h4); margin: 1rem 0 .5rem; }
	.inline-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
	.inline-links li { margin: 0; }
	small { color: var(--sl-color-gray-3); }
</style>

---
/**
 * "I want to" task list: each row keeps the task and its API and feature links together (Law of
 * Proximity). Embeddable as a secondary section below any features layout.
 */
import { byTask, featureHref, apiHref } from '../../lib/features-overview';
interface Props { id?: string; heading?: string }
const { id = 'tasks', heading = 'I want to…' } = Astro.props;
---
<section class="task-list" aria-labelledby={id}>
	<h2 id={id}>{heading}</h2>
	<ul>
		{byTask.map(t => (
			<li>
				<span class="task">{t.task}</span>
				{t.apis.map(a => <a class="api" href={apiHref(a)}><code>{a}</code></a>)}
				<a class="feat" href={featureHref(t.page.id)}>{t.page.title}</a>
			</li>
		))}
	</ul>
</section>
<style>
	.task-list { margin: 0; }
	.task-list h2 { margin-top: 2rem; }
	.task-list ul { list-style: none; padding: 0; margin: .5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); column-gap: 1.5rem; }
	.task-list li { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: .125rem .375rem; padding: .375rem 0; border-bottom: 1px solid var(--sl-color-hairline); }
	.task { font-weight: 600; margin-right: .125rem; }
	.task::after { content: ':'; }
	.api, .feat { text-decoration: none; }
	.api code { font-size: var(--sl-text-xs); }
	.feat { font-size: var(--sl-text-xs); font-weight: 600; color: var(--sl-color-text-accent); padding: 0 .375rem; border-radius: 999px; background: var(--sl-color-accent-low); }
	.feat::after { content: ' →'; }
	.task-list a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>

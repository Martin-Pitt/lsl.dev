---
/**
 * Compact "I want to" menu: a single trigger that opens a dropdown of every task on hover or
 * keyboard focus. Each task lists its API shortcuts and feature link, as in TaskList. Experimental, used below the landing hero.
 * Data: src/lib/features-overview.ts (same as TaskList).
 */
import { byTask, featureHref, apiHref } from '../../lib/features-overview';
---
<nav class="task-menu" aria-label="I want to">
	<button type="button" class="trigger" aria-haspopup="true">I want to… <span aria-hidden="true">▾</span></button>
	<ul class="panel">
		{byTask.map(t => (
			<li>
				<span class="task">{t.task}:</span>
				{t.apis.map(a => <a class="api" href={apiHref(a)}><code>{a}</code></a>)}
				<a class="feat" href={featureHref(t.page.id)}>{t.page.title}</a>
			</li>
		))}
	</ul>
</nav>
<style>
	.task-menu { position: relative; width: fit-content; margin: 0 auto 2rem; }
	.trigger { font: inherit; font-size: var(--sl-text-lg); font-weight: 600; cursor: pointer; padding: .5rem 1.25rem; border-radius: 999px; border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-bg-nav); color: var(--sl-color-white); }
	.trigger span { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	.panel { position: absolute; top: 100%; left: 50%; translate: -50% 0; z-index: 10; width: min(56rem, 92vw); max-height: 70vh; overflow-y: auto; margin: 0; padding: .5rem; list-style: none; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-bg-nav); box-shadow: var(--sl-shadow-lg); visibility: hidden; opacity: 0; transition: opacity .15s, visibility .15s; }
	/* Anchor positioning: below the button, or above it when that side has more room, so the panel
	   stays on screen; when neither side fits, shrunk to the larger side. Older browsers keep the absolute fallback. */
	@supports (position-area: bottom) {
		.trigger { anchor-name: --task-menu; }
		.panel { position: fixed; position-anchor: --task-menu; position-area: bottom; position-try-fallbacks: flip-block, --task-menu-shrink-below, --task-menu-shrink-above; position-try-order: most-height; max-height: min(60vh, 32rem); top: auto; left: auto; translate: none; margin-block: .5rem; }
	}
	@position-try --task-menu-shrink-below { position-area: bottom; max-height: calc(100% - 1rem); }
	@position-try --task-menu-shrink-above { position-area: top; max-height: calc(100% - 1rem); }
	/* Gap bridge above and below, so the pointer can reach the panel on either side without closing it */
	.panel::before { content: ''; position: absolute; inset: -.75rem 0; z-index: -1; }
	.task-menu:hover .panel, .task-menu:focus-within .panel { visibility: visible; opacity: 1; }
	.panel li { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .5rem; padding: .375rem .625rem; border-radius: .375rem; transition: background-color .1s; }
	.panel li:hover, .panel li:focus-within { background: color-mix(in srgb, var(--sl-color-accent-low) 30%, transparent); }
	.task { font-weight: 600; margin-right: .5rem; }
	.task::first-letter { text-transform: uppercase; }
	.api, .feat { text-decoration: none; }
	.api code { font-size: var(--sl-text-xs); }
	.feat { font-size: var(--sl-text-xs); font-weight: 600; color: var(--sl-color-text-accent); padding: 0 .375rem; border-radius: 999px; background: var(--sl-color-accent-low); }
	.feat::after { content: ' →'; }
	.panel a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>

---
/** Header of an LSL function page: chips, signature and facts from the LSL definitions. Usage: <LSLFunction name="..." /> (add `description` on pages without wiki prose) */
import ApiHeader from './ApiHeader.astro';
/** description: show the definitions' one-line description (pages with no wiki prose of their own). */
interface Props { name: string; description?: boolean }
---
<ApiHeader name={Astro.props.name} description={Astro.props.description} kind="function" />

---
/**
 * Footer of an API page: a link to the live wiki article and the CC BY-SA attribution, from the
 * page's `source` frontmatter (written by scripts/generate-mdx.py). Renders nothing without a source.
 */
import WikiAttribution from '../reference/WikiAttribution.astro';
const source = (Astro.locals as any).starlightRoute?.entry?.data?.source;
---
{source && (
	<div class="wiki-content">
		<details class="source-note" data-pagefind-ignore><summary>Original wiki source</summary>
			<p>Some wiki templates and tables need their original context. <a href={source.url}>View this article on the Second Life Wiki</a>. Technical wording and examples are retained from the source; historical guidance may differ from current behavior.</p>
		</details>
		<WikiAttribution source={source} />
	</div>
)}

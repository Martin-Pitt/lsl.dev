---
/**
 * PROTOTYPE shell for /prototypes/features/* (temporary; see docs/prototypes/features-index.md).
 * Banner + variant switcher; excluded from search (pagefind: false + data-pagefind-ignore),
 * noindex, and absent from the sidebar (astro.config.mjs lists sidebar links explicitly).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
interface Props { variant: string; title: string; summary: string }
const { variant, title, summary } = Astro.props;
const variants = [
	{ id: 'a', label: 'A · By goal' },
	{ id: 'b', label: 'B · Task-first' },
	{ id: 'c', label: 'C · Dashboard' },
	{ id: 'd', label: 'D · Search + groups' },
];
---
<StarlightPage frontmatter={{
	title: `Prototype ${variant.toUpperCase()}: ${title}`,
	description: summary,
	editUrl: false,
	pagefind: false,
	head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, nofollow' } }],
}}>
	<div data-pagefind-ignore="all">
		<aside class="proto-banner" aria-label="Prototype notice">
			<p><strong>Prototype</strong>: a temporary alternative to the <a href="/features/">Features Overview</a>, not linked from the site. {summary}</p>
			<nav aria-label="Prototype variants">
				<ul>
					<li><a href="/features/">Baseline</a></li>
					{variants.map(v => <li><a href={`/prototypes/features/${v.id}/`} aria-current={v.id === variant ? 'page' : undefined}>{v.label}</a></li>)}
				</ul>
			</nav>
		</aside>
		<slot />
	</div>
</StarlightPage>
<style>
	.proto-banner { border: 2px dashed var(--sl-color-orange); background: var(--sl-color-orange-low); color: var(--sl-color-white); border-radius: .5rem; padding: .75rem 1rem; font-size: var(--sl-text-sm); }
	.proto-banner p { margin: 0; }
	.proto-banner ul { display: flex; flex-wrap: wrap; gap: .375rem; list-style: none; padding: 0; margin: .5rem 0 0; }
	.proto-banner li { margin: 0; }
	.proto-banner nav a { display: inline-block; padding: .25rem .625rem; border-radius: 999px; border: 1px solid var(--sl-color-orange); text-decoration: none; color: var(--sl-color-white); min-height: 1.75rem; }
	.proto-banner nav a[aria-current='page'] { background: var(--sl-color-orange); color: var(--sl-color-black); font-weight: 600; }
	:global(.proto a:focus-visible), .proto-banner a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>

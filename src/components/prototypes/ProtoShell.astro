---
/**
 * PROTOTYPE shell for /prototypes/* (temporary; see docs/prototypes/features-index.md).
 * No banner: the pages are opened by URL. Kept out of search (pagefind: false +
 * data-pagefind-ignore), noindex, and absent from the sidebar (astro.config.mjs lists links explicitly).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
interface Props { title: string; summary: string; splash?: boolean }
const { title, summary, splash = false } = Astro.props;
---
<StarlightPage frontmatter={{
	title,
	description: summary,
	editUrl: false,
	pagefind: false,
	...(splash ? { template: 'splash' as const, tableOfContents: false } : {}),
	head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, nofollow' } }],
}}>
	<div data-pagefind-ignore="all"><slot /></div>
</StarlightPage>

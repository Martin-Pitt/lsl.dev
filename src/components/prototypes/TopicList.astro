---
// PROTOTYPE: one nested list of portal topics (recursive). Gaps render as plain text.
import { resolve, type Topic } from '../../lib/prototypes/portal-topics';
interface Props { topics: Topic[]; showAlso?: boolean }
const { topics, showAlso = true } = Astro.props;
---
<ul class="topics">
	{topics.map(t => (
		<li>
			{t.to
				? <a class={`k-${resolve(t.to).kind}`} href={resolve(t.to).href}>{t.label}</a>
				: <span class="gap">{t.label}<span class="gap-tag">no page</span></span>}
			{showAlso && t.also && <span class="also">{t.also.map(r => resolve(r)).map(l => <a href={l.href}>{l.kind === 'group' ? <code>{l.label}</code> : l.label}</a>)}</span>}
			{t.children && <Astro.self topics={t.children} showAlso={showAlso} />}
		</li>
	))}
</ul>
<style>
	.topics { list-style: none; padding: 0; margin: 0; }
	.topics .topics { padding-left: .875rem; border-left: 1px solid var(--sl-color-hairline); margin: .125rem 0 .25rem .25rem; }
	.topics li { margin: 0; padding: .0625rem 0; line-height: 1.4; }
	.topics a { text-decoration: none; }
	.topics a:hover { text-decoration: underline; }
	.topics a.k-feature { font-weight: 600; }
	.also { margin-left: .375rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.also a { color: var(--sl-color-gray-2); }
	.also a + a::before { content: '· '; color: var(--sl-color-gray-4); }
	.also code { font-size: inherit; }
	.gap { color: var(--sl-color-gray-3); }
	.gap-tag { margin-left: .375rem; font-size: var(--sl-text-xs); padding: 0 .3rem; border: 1px dashed var(--sl-color-gray-4); border-radius: .25rem; }
	a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>

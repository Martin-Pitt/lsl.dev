---
/**
 * Function, event and constant detail page, laid out like the hand-written pages: chips, signature
 * block, lead prose, a "How to use" snippet, then the wiki's Specification, Caveats, Examples and
 * the remaining sections. Breadcrumbs are rendered above the title by the route (banner slot).
 */
import { Code } from '@astrojs/starlight/components';
import ApiSignature from './ApiSignature.astro';
import WikiHtml from './WikiHtml.astro';
import WikiAttribution from './WikiAttribution.astro';
import { catalog, categoryMap, categoryHref, apiHref, featuresForApi, featureHref, constantGroupHref, searchAliases } from '../../lib/catalog';
import { PROSE_IDS, usageSnippet } from '../../lib/api-page';
import { inlineLsl, enhanceText } from '../../lib/inline-lsl';
const { entry } = Astro.props;
const d = entry.definition;
const memberships: string[] = d['member-of'] || [];
const featureAreas = featuresForApi(entry);
const aliases = searchAliases[entry.name] || [];
const flags = [['experience','Requires an experience'],['linden-experience','Linden experience only'],['god-mode','Privileged function']].filter(([key])=>d[key]);
const sections = (entry.wiki?.sections || []) as { id: string; title: string; html: string }[];
const prose = sections.filter(s => PROSE_IDS.has(s.id));
const rest = sections.filter(s => !PROSE_IDS.has(s.id));
const usage = usageSnippet(entry);
const description = await enhanceText(entry.description, { self: entry.name });
const sleep = d['mono-sleep'] ?? d.sleep;
const facts = [
	entry.kind === 'function' && entry.returnType !== 'void' && ['Returns', await inlineLsl(entry.returnType)],
	entry.kind === 'function' && sleep ? ['Delay', `${sleep} s`] : null,
	entry.kind === 'function' && d.energy != null ? ['Energy', String(d.energy)] : null,
	d['requires-permission'] && ['Permission', await inlineLsl(String(d['requires-permission']))],
].filter(Boolean) as [string, string][];
const groups = await Promise.all(memberships.map(async group => ({
	group,
	related: await Promise.all(catalog.constants.filter(c => (c.definition as any)['member-of']?.includes(group) && c.name !== entry.name)
		.map(async c => ({ href: apiHref('constant', c.name), name: await inlineLsl(c.name, { link: false }), value: String(c.definition.value) }))),
})));
---
<div class="api-chips">
	<span class="api-kind">{entry.kind}</span>
	{flags.map(([, label]) => <span class="api-flag">{label}</span>)}
	{entry.categories.map((id: string) => <a class="api-chip" href={categoryHref(id)}>{categoryMap.get(id)?.label || id}</a>)}
	{featureAreas.map(c => <a class="api-chip api-chip-feature" href={featureHref(c.id)} title="Feature area">{c.title}</a>)}
</div>
{aliases.map(a => <p class="search-alias" data-pagefind-weight="2">Looking for <code>{a.alias}</code>? {a.note}</p>)}

<ApiSignature entry={entry} />
{facts.length > 0 && <dl class="api-facts not-content">{facts.map(([k, v]) => <div><dt>{k}</dt><dd set:html={v} /></div>)}</dl>}

<div class="api-prose wiki-content">
	<p class="api-description" set:html={description} />
	{prose.map(s => <div id={s.id}><WikiHtml html={s.html} focus={entry.name} /></div>)}
</div>

{usage && <Code code={usage} lang="lsl" title="How to use" frame="terminal" />}

{memberships.length > 0 && (
	<section class="api-groups">
		<h2 id="constant-groups">Constant groups</h2>
		<p>{memberships.map((g, i) => <>{i > 0 && ' · '}<a href={constantGroupHref(g)}>{g}</a></>)}</p>
		{groups.map(({ group, related }) => related.length > 0 && (
			<details><summary>Other {group} values ({related.length})</summary>
				<ul>{related.map(c => <li><a class="lsl-ref" href={c.href} set:html={c.name} /> <code>{c.value}</code></li>)}</ul>
			</details>
		))}
	</section>
)}

{entry.wiki ? (
	<div class="wiki-content">
		{rest.map(s => (
			<section class={`api-section api-section-${s.id}`}>
				<h2 id={s.id}>{s.title}</h2>
				<WikiHtml html={s.html} focus={entry.name} examples={s.id === 'examples'} />
			</section>
		))}
		<details class="source-note" data-pagefind-ignore><summary>Original wiki source</summary>
			<p>Some wiki templates and tables need their original context. <a href={entry.wiki.rawPath}>Read the complete source text</a> or <a href={entry.wiki.source.revisionUrl || entry.wiki.source.url}>open this wiki revision</a>. Technical wording and examples are retained from the source; historical guidance may differ from current behavior.</p>
		</details>
		<WikiAttribution source={entry.wiki.source} />
	</div>
) : (
	<aside class="coverage"><h2 id="documentation">Documentation</h2><p>This entry is documented in the LSL definitions. No matching wiki article is present in this local collection. Its inclusion here does not establish availability on every simulator.</p></aside>
)}
<style>
	.api-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .5rem; }
	.api-kind, .api-flag { font-size: var(--sl-text-2xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.api-kind { color: var(--sl-color-text-accent); margin-inline-end: .25rem; }
	.api-flag { background: var(--sl-color-gray-6); padding: .1rem .5rem; border-radius: .25rem; }
	.api-chip { font-size: var(--sl-text-xs); text-decoration: none; color: var(--sl-color-gray-2); border: 1px solid var(--sl-color-hairline); border-radius: 2rem; padding: .15rem .65rem; line-height: 1.5; }
	.api-chip:hover { color: var(--sl-color-white); border-color: var(--sl-color-text-accent); }
	.api-chip-feature { border-color: var(--sl-color-accent); color: var(--sl-color-text-accent); }
	.api-facts { display: flex; flex-wrap: wrap; gap: .25rem 1.75rem; margin: .75rem 0 0; font-size: var(--sl-text-sm); }
	.api-facts div { display: flex; gap: .45rem; align-items: baseline; }
	.api-facts dt { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
	.api-facts dd { margin: 0; }
	.api-description { font-size: var(--sl-text-lg); line-height: 1.65; white-space: pre-line; }
	.api-prose > * + * { margin-top: .75rem; }
	.api-section { margin-top: 2.5rem; }
	.search-alias { font-size: var(--sl-text-sm); border-inline-start: 3px solid var(--sl-color-accent); padding-inline-start: .75rem; }
	.coverage { margin-top: 2rem; border-inline-start: 3px solid var(--sl-color-accent); padding-left: 1.2rem; }
	.api-groups ul { columns: 2 18rem; }
</style>

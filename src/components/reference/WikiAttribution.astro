---
const { source } = Astro.props;
---
<footer class="wiki-attribution" data-pagefind-ignore>
  <strong>From the Second Life Wiki</strong>
  <p>Community documentation adapted from <a href={source.revisionUrl || source.url}>{source.title}</a>,
  by Linden Research, Inc. and contributing residents.
  <a href={source.historyUrl}>View contributors and history</a>.</p>
  <p>Licensed under <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>.
  {source.timestamp && <> Source revision: <time datetime={source.timestamp}>{source.timestamp.slice(0,10)}</time>.</>}
  Formatting and links have been adapted for this site; API metadata follows the LSL definitions.</p>
</footer>
<style>.wiki-attribution{margin-top:3rem;padding:1.2rem 1.4rem;border:1px solid var(--sl-color-hairline);border-radius:.7rem;font-size:.85rem;color:var(--sl-color-gray-2)}.wiki-attribution p{margin:.5rem 0 0}</style>

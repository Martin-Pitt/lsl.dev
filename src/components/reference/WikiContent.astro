---
import WikiAttribution from './WikiAttribution.astro';
const { wiki, attribution = true } = Astro.props;
---
<div class="wiki-content" set:html={wiki.html} />
<details class="source-note" data-pagefind-ignore><summary>Original wiki source</summary>
<p>Some wiki templates and tables need their original context. <a href={wiki.rawPath}>Read the complete source text</a> or <a href={wiki.source.revisionUrl || wiki.source.url}>open this wiki revision</a>. Technical wording and examples are retained from the source; historical guidance may differ from current behavior.</p></details>
{attribution && <WikiAttribution source={wiki.source}/>}
<style is:global>
.wiki-content{overflow-wrap:anywhere}.wiki-content section{margin-top:2rem}.wiki-content .wiki-line{margin:.65em 0}.wiki-content pre{overflow:auto;max-width:100%;padding:1rem;border:1px solid var(--sl-color-hairline);border-radius:.6rem;background:var(--sl-color-gray-6);font-size:.85rem;line-height:1.6}.wiki-content pre code{padding:0;background:none}.wiki-content table{display:block;overflow-x:auto;max-width:100%}.wiki-content .wiki-template{font-size:.82em;padding:.1em .3em;border:1px dashed var(--sl-color-gray-4);border-radius:.25rem}.source-note{margin-top:2rem;padding:1rem;border:1px solid var(--sl-color-hairline);border-radius:.5rem}.source-note summary{cursor:pointer;font-size:.9rem;color:var(--sl-color-gray-2)}
</style>

---
// Animated homepage hero: nine script cards drop into a plywood prim in turn, and
// the prim reacts to each (sparkles + chat, orange tint, fast spin, hover text, a touch,
// scrolling texture, glow, a rezzed copy, gamepad driving).
// Pure HTML/CSS, decorative. One shared 90s timeline (--loop) of nine 10s
// segments (--seg); every step is a keyframe window on it, and each card runs
// the same keyframes delayed by its segment (--k). Every cycle animation also adds
// --start to its delay; the one-line script below sets it to a random whole number of
// segments (back), so each visit starts somewhere else (no JS: segment 1).
import plywood from '../../assets/hero/plywood.webp';
const particles = Array.from({ length: 10 }, (_, i) => i);
---

<div class="scene" aria-hidden="true" style={`--plywood: url("${plywood.src}")`}>
	<div class="stage">
		<div class="omega-cue" />
		<div class="glow" />
		<div class="float">
			<div class="cube">
				{Array.from({ length: 6 }, () => <div class="face"><i class="tex" /></div>)}
				<div class="shadow" />
				<div class="rez">{Array.from({ length: 6 }, () => <div class="face" />)}</div>
			</div>
			<div class="script-card" style="--k: 0">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llSay</span>(<span class="n">0</span>, <span class="s">"Hello, World!"</span>);
    <span class="f">llParticleSystem</span>([<span class="rules"><span class="hidden-rules">PSYS_PART_FLAGS, PSYS_PART_EMISSIVE_MASK | PSYS_PART_INTERP_COLOR_MASK | PSYS_PART_INTERP_SCALE_MASK | PSYS_PART_FOLLOW_VELOCITY_MASK, PSYS_SRC_PATTERN, PSYS_SRC_PATTERN_EXPLODE, PSYS_SRC_BURST_PART_COUNT, 10, PSYS_SRC_BURST_RATE, 0.1, PSYS_SRC_BURST_SPEED_MIN, 0.5, PSYS_SRC_BURST_SPEED_MAX, 1.0, PSYS_SRC_MAX_AGE, 1.0, PSYS_PART_MAX_AGE, 1.0, PSYS_PART_START_COLOR, &lt;1.0, 0.85, 0.4&gt;, PSYS_PART_END_COLOR, &lt;1.0, 1.0, 1.0&gt;, PSYS_PART_START_ALPHA, 1.0, PSYS_PART_END_ALPHA, 0.0, PSYS_PART_START_SCALE, &lt;0.15, 0.15, 0.0&gt;, PSYS_PART_END_SCALE, &lt;0.05, 0.05, 0.0&gt;</span></span>]);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 1; --drop: 2.5cqi">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llSetColor</span>(&lt;<span class="n">1</span>, <span class="n">0.4</span>, <span class="n">0.2</span>&gt;, <span class="c">ALL_SIDES</span>);
    <span class="f">llSleep</span>(<span class="n">2.0</span>);
    <span class="f">llSetColor</span>(&lt;<span class="n">1</span>, <span class="n">1</span>, <span class="n">1</span>&gt;, <span class="c">ALL_SIDES</span>);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 2">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llTargetOmega</span>(&lt;<span class="n">0</span>, <span class="n">0</span>, <span class="n">1</span>&gt;, <span class="c">PI</span>, <span class="n">1.0</span>);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 3">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llSetText</span>(<span class="s">"Hello!"</span>, &lt;<span class="n">1</span>, <span class="n">1</span>, <span class="n">1</span>&gt;, <span class="n">1.0</span>);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 4">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">touch_start</span>(<span class="k">integer</span> total_number) &#123;
    <span class="f">llSay</span>(<span class="n">0</span>, <span class="s">"Touched."</span>);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 5; --drop: 4cqi">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llSetTextureAnim</span>(
      <span class="c">ANIM_ON</span> | <span class="c">SMOOTH</span> | <span class="c">LOOP</span>, <span class="c">ALL_SIDES</span>,
      <span class="n">1</span>, <span class="n">1</span>, <span class="n">0.0</span>, <span class="n">1.0</span>, <span class="n">0.25</span>);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 6; --drop: 2.5cqi">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llSetLinkPrimitiveParamsFast</span>(<span class="c">LINK_THIS</span>,
      [<span class="c">PRIM_GLOW</span>, <span class="c">ALL_SIDES</span>, <span class="n">0.5</span>]);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 7; --drop: 4cqi">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">state_entry</span>() &#123;
    <span class="f">llRezObject</span>(<span class="s">"Object"</span>,
      <span class="f">llGetPos</span>() + &lt;<span class="n">0</span>, <span class="n">0</span>, <span class="n">1</span>&gt;,
      <span class="c">ZERO_VECTOR</span>, <span class="c">ZERO_ROTATION</span>, <span class="n">0</span>);
  &#125;
&#125;</code></pre>
			</div>
			<div class="script-card" style="--k: 8; --drop: 3.5cqi; --fs: 1.9cqi">
				<div class="card-title">New Script</div>
				<pre><code><span class="k">default</span> &#123;
  <span class="e">game_control</span>(<span class="k">key</span> id,
    <span class="k">integer</span> button_levels, <span class="k">list</span> axes) &#123;
    <span class="f">llSetPos</span>(<span class="f">llGetPos</span>() + &lt;
      <span class="f">llList2Float</span>(axes,
        <span class="c">GAME_CONTROL_AXIS_LEFTX</span>),
      <span class="f">llList2Float</span>(axes,
        <span class="c">GAME_CONTROL_AXIS_LEFTY</span>),
      <span class="n">0</span>&gt; * <span class="n">0.1</span>);
  &#125;
&#125;</code></pre>
			</div>
		</div>
		<div class="burst">
			{particles.map((i) => <span style={`--i: ${i}`} />)}
		</div>
	</div>

	<div class="hover-text">Hello!</div>

	<div class="bubble">
		<span class="dots"><i></i><i></i><i></i></span>
		<span class="text"><b>Object:</b> Hello, World!</span>
	</div>

	<div class="click-ring" />
	<svg class="cursor" viewBox="0 0 14 20"><path d="M1 1V16.5L5 12.8L7.8 19L10.6 17.8L7.9 11.7H13Z" /></svg>
	<div class="bubble touch-bubble">
		<span class="dots"><i></i><i></i><i></i></span>
		<span class="text"><b>Object:</b> Touched.</span>
	</div>

	<svg class="gamepad" viewBox="0 0 40 26">
		<path class="pad" d="M8 4H32C37 4 40 10 40 17C40 23 36 25 33 22L29 18H11L7 22C4 25 0 23 0 17C0 10 3 4 8 4Z" />
		<circle class="well" cx="12" cy="11" r="4.2" />
		<circle class="stick" cx="12" cy="11" r="2.6" />
		<path class="arrow arrow-r" d="M20 11L16.8 8.2V13.8Z" />
		<path class="arrow arrow-ul" d="M4.6 3.6L10 4.6L5.6 9Z" />
		{[[28, 8], [31.5, 11.5], [24.5, 11.5], [28, 15]].map(([cx, cy]) => <circle class="btn" cx={cx} cy={cy} r="1.5" />)}
	</svg>
</div>
<!-- Random start: a whole number of 10s segments back, so every cycle animation stays in step. -->
<script is:inline>document.currentScript.previousElementSibling.style.setProperty('--start', Math.floor(Math.random() * 9) * -10 + 's');</script>

<style>
	@property --spin {
		syntax: '<angle>';
		inherits: true; /* the faces read it for their shading */
		initial-value: 0deg;
	}
	/* Extra rotation from llTargetOmega (segment 3), added to --spin wherever --spin is read. */
	@property --omega {
		syntax: '<angle>';
		inherits: true;
		initial-value: 0deg;
	}
	/* PRIM_GLOW strength (segment 7), 0–1: animated on .stage, read by the faces and the halo. */
	@property --glow {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	/* Keyframe percentages are of the 90s loop: 1s = 1.111%, segment n starts at (n − 1) × 11.111%. */
	.scene {
		--loop: 90s;
		--seg: 10s;
		--start: 0s; /* set by the inline script: minus a random whole number of segments */
		--cube: 34cqi;
		position: relative;
		width: 100%;
		aspect-ratio: 1;
		container-type: inline-size;
	}

	/* ---- Cube ---- */
	.stage {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		perspective: 140cqi;
		animation: glow var(--loop) ease-in-out var(--start) infinite;
	}
	.float {
		position: relative; /* paints over the glow halo behind it */
		transform-style: preserve-3d;
		/* The bob is ambient; the game_control drive (segment 9) is a translate on the same element,
		   so the prim and its shadow slide together without touching rotation or lighting. */
		animation:
			float 6s ease-in-out infinite,
			drive var(--loop) ease-in-out var(--start) infinite;
	}
	/* Cube technique from the author's CodePen (nexii/yLwRyMq): Z-up prim, faces
	   stacked in one grid cell and pushed out by --offset, lit by a ::before veil. */
	.cube {
		--offset: calc(var(--cube) * 0.499);
		display: grid;
		width: var(--cube);
		aspect-ratio: 1;
		transform-style: preserve-3d;
		transform: rotateX(70deg) rotateZ(calc(var(--spin) + var(--omega)));
		animation:
			spin 16s linear infinite,
			pulse var(--seg) ease-out var(--start) infinite,
			omega var(--loop) var(--start) infinite,
			press var(--loop) var(--start) infinite;
	}
	.face,
	.shadow {
		grid-area: 1 / -1;
	}
	.face {
		display: grid;
		backface-visibility: hidden;
		/* Flat, so the ::before veil is painted onto the face instead of sharing its 3D plane
		   (where it z-fights and drops out at some angles). */
		transform-style: flat;
		/* Repeating, one tile per face, so llSetTextureAnim can scroll it by a whole tile. */
		background: var(--plywood) 0 0 / 100% repeat;
		/* PRIM_GLOW lightens the face itself, shading included. */
		filter: brightness(calc(1 + var(--glow) * 0.6));
		animation: scroll var(--loop) ease-in-out var(--start) infinite;
	}
	.face:nth-child(1) { transform: translateZ(var(--offset)) scale(1.005); }
	.face:nth-child(2) { transform: rotateX(0.25turn) rotateZ(0.5turn) translateZ(var(--offset)) scale(1.005); }
	.face:nth-child(3) { transform: rotateY(0.25turn) rotateZ(0.75turn) translateZ(var(--offset)) scale(1.005); }
	.face:nth-child(4) { transform: rotateX(0.75turn) translateZ(var(--offset)) scale(1.005); }
	.face:nth-child(5) { transform: rotateY(0.75turn) rotateZ(0.25turn) translateZ(var(--offset)) scale(1.005); }
	.face:nth-child(6) { transform: rotateY(0.5turn) translateZ(var(--offset)) scale(1.005); }

	/* Lighting: a directional light at --light (angle around the prim's Z axis). Each side face's
	   outward normal is at --n; as the prim spins, the face is darkened by how far it turns away
	   from the light (Lambert: 1 − max(0, cos θ)), between --lit and --unlit. The top is always
	   lit, the bottom always dark. */
	.cube {
		--light: 225deg;
		--lit: 0.02;
		--unlit: 0.5;
	}
	.face::before,
	.face::after {
		content: '';
		grid-area: 1 / 1;
	}
	.face::before {
		background: black;
		opacity: calc(var(--lit) + (var(--unlit) - var(--lit)) * (1 - max(0, cos(var(--n) + var(--spin) + var(--omega) - var(--light)))));
	}
	/* llSetColor (segment 2): a multiply tint over texture and shading, so both stay readable. */
	.face::after {
		background: rgb(255 102 51); /* <1, 0.4, 0.2> */
		mix-blend-mode: multiply;
		opacity: 0;
		animation: tint var(--loop) ease-in-out var(--start) infinite;
	}
	.face:nth-child(1)::before { opacity: 0; }
	.face:nth-child(6)::before { opacity: 0.6; }
	.face:nth-child(2) { --n: 270deg; }
	.face:nth-child(3) { --n: 0deg; }
	.face:nth-child(4) { --n: 90deg; }
	.face:nth-child(5) { --n: 180deg; }
	/* Reduced-motion stand-in for the texture scroll (see below); unused otherwise. */
	.tex { display: none; }

	/* Ground contact shadow under the prim. */
	.shadow {
		background: black;
		transform: translateZ(calc(var(--offset) * -1));
		box-shadow: 0 0 6cqi 2cqi black;
		opacity: 0.15;
	}

	@keyframes spin { to { --spin: 360deg; } }
	@keyframes float {
		50% { transform: translateY(-2.5cqi); }
	}
	/* The prim "takes" each script: a short squash at ~40% of every segment (4s). */
	@keyframes pulse {
		0%, 39%, 50%, 100% { scale: 1; }
		42% { scale: 1.07; }
		45% { scale: 0.97; }
	}
	/* Segment 2: tint as the card lands (14.1s), hold for the script's llSleep(2.0), then back. */
	@keyframes tint {
		0%, 15.667% { opacity: 0; }
		16.222%, 18.444% { opacity: 0.75; }
		19.111%, 100% { opacity: 0; }
	}
	/* Segment 3 (lands at 24s): ease in to a fast spin, hold, ease out: 4 extra turns, so the
	   wrap back to 0 at the loop end is invisible. The curves' end/start slopes (2x) match the
	   linear middle, so the speed is continuous. */
	@keyframes omega {
		0%, 26.889% { --omega: 0deg; animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0.5); }
		28.667% { --omega: 360deg; animation-timing-function: linear; }
		30.444% { --omega: 1080deg; animation-timing-function: cubic-bezier(0.25, 0.5, 0.5, 1); }
		32.222%, 100% { --omega: 1440deg; }
	}
	/* Segment 5: the touch, a quick push in as the cursor clicks (45.4s). */
	@keyframes press {
		0%, 50.444% { translate: 0; }
		50.667% { translate: 0 0.8cqi; }
		51.111%, 100% { translate: 0; }
	}
	/* Segment 6: llSetTextureAnim scrolls one whole tile across every face (54.4–59.6s), easing
	   in and out; a whole tile, so the snap back at the loop end is invisible. */
	@keyframes scroll {
		0%, 60.444% { background-position-x: 0; }
		66.222%, 100% { background-position-x: var(--cube); }
	}
	/* Segment 7: PRIM_GLOW up as the card lands (64.2s), hold, back out before the next card. */
	@keyframes glow {
		0%, 71.333% { --glow: 0; }
		72.889%, 75.556% { --glow: 1; }
		77.556%, 100% { --glow: 0; }
	}
	/* Segment 9: the left stick pushes right (the prim drifts +X), then up-left (away and left),
	   then lets go and the prim eases home by ~89s. The ground plane is foreshortened, so +Y
	   (away from the camera) is a small upward move. */
	@keyframes drive {
		0%, 94.222% { translate: 0 0; }
		96.222% { translate: 9cqi 0; }
		97.778% { translate: 3cqi -2.5cqi; }
		99.111%, 100% { translate: 0 0; }
	}

	/* ---- Segment 7: a soft halo behind the prim (the bloom), driven by --glow. ---- */
	.glow {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 80cqi;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, light-dark(oklch(0.92 0.12 90 / 0.9), oklch(0.97 0.07 95 / 0.8)), transparent 62%);
		opacity: var(--glow);
	}

	/* ---- Segment 8: llRezObject. A smaller copy pops up out of the prim to llGetPos() + <0, 0, 1>
	   (74.2–75.4s), hangs there, then fades out by 79.4s. It's a child of .cube, so it shares the
	   prim's frame (Z up) and --spin/--omega, and its faces shade exactly like the prim's. ---- */
	.rez {
		--mini: calc(var(--cube) * 0.45);
		--offset: calc(var(--mini) * 0.499);
		--rise: calc(var(--cube) * 0.5 + var(--mini) * 0.5 + 6cqi);
		grid-area: 1 / 1;
		place-self: center;
		display: grid;
		width: var(--mini);
		aspect-ratio: 1;
		transform-style: preserve-3d;
		transform: scale(0.2);
		animation: rez var(--loop) var(--start) infinite;
	}
	/* The faces fade, not .rez: opacity on .rez would flatten its 3D. */
	.rez .face {
		opacity: 0;
		animation: rez-fade var(--loop) ease-in-out var(--start) infinite;
	}
	@keyframes rez {
		0%, 82.444% { transform: translateZ(0) scale(0.2); animation-timing-function: cubic-bezier(0.3, 1.5, 0.5, 1); }
		83.778%, 86.444% { transform: translateZ(var(--rise)) scale(1); animation-timing-function: ease-in; }
		88.222% { transform: translateZ(calc(var(--rise) + 3cqi)) scale(0.7); }
		88.444%, 100% { transform: translateZ(0) scale(0.2); }
	}
	@keyframes rez-fade {
		0%, 82.444% { opacity: 0; }
		82.667%, 86.444% { opacity: 1; }
		88.222%, 100% { opacity: 0; }
	}

	/* ---- Script cards: each appears above the prim, hovers, then falls in through the top face
	   (the first 4s of its segment; card --k runs the same keyframes delayed by k segments).
	   It lives in the cube's 3D context (inside .float), so the faces really intersect and hide it. ---- */
	.float {
		display: grid;
		place-items: center;
	}
	.cube,
	.script-card {
		grid-area: 1 / 1;
	}
	.script-card {
		min-width: 52cqi;
		width: max-content;
		padding: 2cqi 2.5cqi;
		border-radius: 2cqi;
		background: light-dark(oklch(0.99 0 0 / 0.92), oklch(0.24 0.02 260 / 0.92));
		border: 1px solid color-mix(in oklch, var(--sl-color-gray-5) 70%, transparent);
		box-shadow: 0 2cqi 5cqi oklch(0 0 0 / 0.18);
		color: var(--sl-color-gray-2);
		/* The long game_control card sets a smaller --fs so it stays card-sized. */
		font-size: var(--fs, 2.6cqi);
		/* A taller card (more lines) sits a little lower so its top stays inside the scene. */
		position: relative;
		top: var(--drop, 0);
		opacity: 0;
		animation: card var(--loop) calc(var(--k) * var(--seg) + var(--start)) infinite;
	}
	.card-title {
		user-select: none;
		font-family: var(--sl-font-system, system-ui);
		font-weight: 600;
		margin-bottom: 1cqi;
		color: var(--sl-color-white);
	}
	.script-card pre {
		margin: 0;
		padding: 0;
		background: none;
		border: 0;
		font: inherit;
		font-family: var(--__sl-font-mono, ui-monospace, monospace);
		line-height: 1.45;
		white-space: pre;
	}
	.k { color: light-dark(oklch(0.5 0.2 300), oklch(0.75 0.15 300)); }
	.e { color: light-dark(oklch(0.5 0.15 250), oklch(0.78 0.12 230)); }
	/* The real particle rules are in the text (so copying the script gives a working one) but
	   collapsed; the "…" shown in their place is generated content, which copying skips. */
	.hidden-rules {
		/* Visually hidden (the usual screen-reader-only box): out of layout but still selectable. */
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.rules { position: relative; }
	.rules::before { content: '…'; }
	.f { color: light-dark(oklch(0.5 0.13 160), oklch(0.8 0.13 160)); }
	.s { color: light-dark(oklch(0.52 0.15 40), oklch(0.8 0.12 60)); }
	.n { color: light-dark(oklch(0.55 0.15 20), oklch(0.78 0.14 20)); }
	.c { color: light-dark(oklch(0.5 0.15 250), oklch(0.78 0.12 230)); }

	/* Each step eases on its own: settle in, hover, a small lift (anticipation), then a gravity-like
	   fall that accelerates into the prim, landing as it squashes (pulse, ~40%). The window is the
	   loop's first 4.444% (4s). */
	@keyframes card {
		0% { opacity: 0; transform: translateY(-34cqi) scale(0.8); animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1); }
		0.778% { opacity: 1; transform: translateY(-38cqi) scale(0.85); animation-timing-function: ease-in-out; }
		1.778% { transform: translateY(-36.5cqi) scale(0.85); animation-timing-function: ease-in-out; }
		2.778% { transform: translateY(-38cqi) scale(0.85); animation-timing-function: cubic-bezier(0.3, 0, 0.5, 1); }
		3.333% { opacity: 1; transform: translateY(-42cqi) scale(0.8) rotateX(-6deg); animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.4); }
		4.389% { opacity: 1; transform: translateY(0) scale(0.45); }
		4.444%, 100% { opacity: 0; transform: translateY(0) scale(0.45); }
	}

	/* ---- Segment 1: particle burst from the cube centre (4–5.6s). ---- */
	.burst {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
	}
	.burst span {
		grid-area: 1 / 1;
		width: 2.4cqi;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, white, oklch(0.85 0.17 calc(60 + var(--i) * 25)) 45%, transparent 70%);
		opacity: 0;
		/* Ten particles evenly spaced around the circle, alternating reach. */
		--a: calc(var(--i) * 36deg + 10deg);
		--r: calc(30cqi + mod(var(--i), 2) * 8cqi);
		animation: burst var(--loop) cubic-bezier(0.2, 0.7, 0.3, 1) var(--start) infinite;
	}
	@keyframes burst {
		0%, 4.444% { opacity: 0; transform: rotate(var(--a)) translateX(4cqi) scale(0.4); }
		4.778% { opacity: 1; }
		6.222%, 100% { opacity: 0; transform: rotate(var(--a)) translateX(var(--r)) scale(1); }
	}

	/* ---- Segment 1: chat bubble, typing dots (4.7–6.4s), then the message until ~9.7s. ---- */
	.bubble {
		position: absolute;
		left: 50%;
		top: 8cqi;
		display: grid;
		place-items: center;
		padding: 1.8cqi 3.6cqi;
		border-radius: 999px;
		background: oklch(0.15 0 0 / 0.72);
		backdrop-filter: blur(4px);
		color: white;
		font-family: var(--sl-font-system, system-ui);
		font-size: 3.6cqi;
		white-space: nowrap;
		translate: -50% 0;
		opacity: 0;
		animation: bubble var(--loop) ease-out var(--start) infinite;
	}
	.bubble > * { grid-area: 1 / 1; }
	.dots { display: flex; gap: 1cqi; animation: dots var(--loop) step-end var(--start) infinite; }
	.dots i {
		width: 1.4cqi;
		aspect-ratio: 1;
		border-radius: 50%;
		background: currentColor;
		animation: dot 0.9s ease-in-out infinite;
	}
	.dots i:nth-child(2) { animation-delay: 0.15s; }
	.dots i:nth-child(3) { animation-delay: 0.3s; }
	.text { opacity: 0; animation: text var(--loop) ease-out var(--start) infinite; }
	.text b { font-weight: 600; opacity: 0.75; }
	/* Segment 5's "Touched." reply is the same bubble run 41s later (45.7–50.7s, after the click). */
	.touch-bubble,
	.touch-bubble .dots,
	.touch-bubble .text {
		animation-delay: calc(var(--start) + 41s);
	}

	@keyframes bubble {
		0%, 5.222% { opacity: 0; transform: translateY(2cqi) scale(0.9); }
		5.556%, 10.222% { opacity: 1; transform: none; }
		10.778%, 100% { opacity: 0; transform: translateY(-2cqi); }
	}
	@keyframes dots {
		0% { opacity: 1; }
		7.111% { opacity: 0; }
	}
	@keyframes text {
		0%, 7.111% { opacity: 0; }
		7.444%, 100% { opacity: 1; }
	}
	@keyframes dot {
		0%, 100% { opacity: 0.35; transform: translateY(0); }
		50% { opacity: 1; transform: translateY(-0.6cqi); }
	}

	/* ---- Segment 4: llSetText hover text above the prim (34–39.4s), SL-style: plain white text
	   with a soft shadow, no background. ---- */
	.hover-text {
		position: absolute;
		left: 50%;
		top: 20cqi;
		color: white;
		font-family: var(--sl-font-system, system-ui);
		font-size: 4.2cqi;
		font-weight: 500;
		/* White like in-world; the shadow is darker on light backgrounds so it still reads. */
		text-shadow:
			0 0.2cqi 0.4cqi light-dark(oklch(0 0 0 / 0.85), oklch(0 0 0 / 0.7)),
			0 0 0.2cqi light-dark(oklch(0 0 0 / 0.9), oklch(0 0 0 / 0.8));
		white-space: nowrap;
		translate: -50% 0;
		opacity: 0;
		animation: hover-text var(--loop) ease-out var(--start) infinite;
	}
	@keyframes hover-text {
		0%, 38% { opacity: 0; transform: translateY(1cqi); }
		38.556%, 42.667% { opacity: 1; transform: none; }
		43.778%, 100% { opacity: 0; transform: none; }
	}

	/* ---- Segment 5: touch_start. A pointer glides in from the lower right (44.2–45.2s), clicks
	   the prim's front face (45.4s, with a ripple), and leaves; the prim answers in chat. ---- */
	.cursor,
	.click-ring {
		position: absolute;
		/* The hit point, on the front face just below the prim's centre. */
		left: calc(50% + 2cqi);
		top: calc(50% + 4cqi);
		opacity: 0;
	}
	.cursor {
		width: 4.4cqi;
		margin: -0.3cqi 0 0 -0.3cqi; /* the arrow's tip on the hit point */
		overflow: visible;
		transform-origin: 0 0;
		fill: white;
		stroke: black;
		stroke-width: 1.1;
		stroke-linejoin: round;
		filter: drop-shadow(0 0.4cqi 0.6cqi oklch(0 0 0 / 0.35));
		animation: cursor var(--loop) var(--start) infinite;
	}
	.click-ring {
		width: 9cqi;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 0.5cqi solid light-dark(oklch(0.35 0 0 / 0.8), white);
		box-shadow: 0 0 2cqi light-dark(oklch(0 0 0 / 0.2), oklch(1 0 0 / 0.5));
		translate: -50% -50%;
		animation: click-ring var(--loop) ease-out var(--start) infinite;
	}
	@keyframes cursor {
		0%, 49.111% { opacity: 0; translate: 24cqi 26cqi; animation-timing-function: cubic-bezier(0.25, 0.6, 0.3, 1); }
		49.556% { opacity: 1; }
		50.222% { translate: 0 0; scale: 1; }
		50.444% { scale: 0.85; }
		50.778% { scale: 1; }
		52.222% { opacity: 1; translate: 0 0; animation-timing-function: ease-in; }
		53.333%, 100% { opacity: 0; translate: 5cqi 7cqi; }
	}
	@keyframes click-ring {
		0%, 50.444% { opacity: 0; scale: 0.3; }
		50.556% { opacity: 0.9; }
		51.556%, 100% { opacity: 0; scale: 1.8; }
	}

	/* ---- Segment 9: game_control. A gamepad fades in beside the prim (84.2s); its left stick
	   pushes right, then up-left, then centres, and the prim drives along (drive, above). ---- */
	.gamepad {
		position: absolute;
		left: 64cqi;
		top: 74cqi;
		width: 22cqi;
		overflow: visible;
		filter: drop-shadow(0 0.8cqi 1.2cqi oklch(0 0 0 / 0.3));
		opacity: 0;
		animation: gamepad var(--loop) ease-in-out var(--start) infinite;
	}
	.pad { fill: light-dark(oklch(0.38 0.02 260), oklch(0.82 0.01 260)); }
	.well { fill: light-dark(oklch(0.25 0.02 260), oklch(0.62 0.01 260)); }
	.stick {
		fill: light-dark(oklch(0.7 0.14 160), oklch(0.5 0.13 160));
		stroke: light-dark(oklch(0.2 0 0), oklch(0.98 0 0));
		stroke-width: 0.5;
		animation: stick var(--loop) ease-in-out var(--start) infinite;
	}
	.btn { fill: light-dark(oklch(0.62 0.02 260), oklch(0.6 0.01 260)); }
	/* Reduced-motion direction cues (see below); hidden otherwise. */
	.arrow {
		fill: oklch(0.85 0.17 85);
		stroke: oklch(0.3 0.05 60);
		stroke-width: 0.4;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 0.8px oklch(0.9 0.18 85));
		opacity: 0;
	}
	@keyframes gamepad {
		0%, 93.556% { opacity: 0; transform: translateY(2cqi); }
		94.111%, 98.444% { opacity: 1; transform: none; }
		99.333%, 100% { opacity: 0; transform: none; }
	}
	/* In SVG user units; held while the prim moves, centred again at 88.2s. */
	@keyframes stick {
		0%, 94.222% { translate: 0 0; }
		94.667%, 96% { translate: 1.8px 0; }
		96.444%, 97.556% { translate: -1.3px -1.3px; }
		98%, 100% { translate: 0 0; }
	}

	/* Reduced-motion stand-in for the segment 3 spin (see below); unused otherwise. */
	.omega-cue { display: none; }

	/* Reduced motion. Project convention: never just remove animations or freeze a frame;
	   replace each motion with a non-motion equivalent (fades, glows, colour) on the same
	   timeline. Motion stays only where it carries critical information (none here). */
	@media (prefers-reduced-motion: reduce) {
		/* The prim holds still at a fixed angle, shaded for it: no float, spin, squash or omega,
		   and no press or drive (those get their own cues below: click ring, gamepad arrows). */
		.float { animation: none; }
		.cube { --spin: 30deg; animation: none; }
		/* Cards cross-fade in and out in place, above the prim. */
		.script-card { animation-name: card-fade; }
		/* Sparkles glow up and fade where they are, instead of flying out. */
		.burst span { animation-name: burst-fade; animation-timing-function: ease-in-out; }
		/* llTargetOmega: a soft warm glow behind the prim instead of a fast spin. */
		.omega-cue {
			display: block;
			grid-area: 1 / 1;
			width: 60cqi;
			aspect-ratio: 1;
			border-radius: 50%;
			background: radial-gradient(circle, oklch(0.85 0.15 80 / 0.55), transparent 65%);
			opacity: 0;
			animation: omega-cue var(--loop) ease-in-out var(--start) infinite;
		}
		.stage > .float { grid-area: 1 / 1; }
		/* Bubble, typing dots and hover text fade only. */
		.bubble { animation-name: bubble-fade; }
		.dots i { animation-name: dot-fade; }
		.hover-text { animation-name: hover-text-fade; }
		/* touch_start: the pointer fades in already on the prim, and the click is a ring that
		   fades in and out at one size. */
		.cursor { animation-name: cursor-fade; }
		.click-ring { animation-name: ring-fade; }
		/* llSetTextureAnim: instead of scrolling, the texture cross-fades to a copy offset by half a
		   tile and back (a layer under the shading, so lighting and tint still apply). */
		.face { animation-name: none; }
		.tex {
			display: block;
			grid-area: 1 / 1;
			order: -1; /* painted under ::before/::after */
			background: var(--plywood) calc(var(--cube) / 2) 0 / 100% repeat;
			opacity: 0;
			animation: tex-fade var(--loop) ease-in-out var(--start) infinite;
		}
		/* PRIM_GLOW has no motion and runs as is. llRezObject: the copy fades in and out at its
		   final spot above the prim, without popping up. */
		.rez { animation: none; transform: translateZ(var(--rise)); }
		/* game_control: the gamepad fades in without rising, the stick stays put, and an arrow
		   lights up for each direction pushed. */
		.gamepad { animation-name: gamepad-fade; }
		.stick { animation-name: none; }
		.arrow-r { animation: arrow-r var(--loop) ease-in-out var(--start) infinite; }
		.arrow-ul { animation: arrow-ul var(--loop) ease-in-out var(--start) infinite; }
	}
	@keyframes card-fade {

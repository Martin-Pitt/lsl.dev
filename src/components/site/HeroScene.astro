		5.111% { opacity: 1; transform: rotate(var(--a)) translateX(calc(var(--r) * 0.7)); }
		6.667%, 100% { opacity: 0; transform: rotate(var(--a)) translateX(calc(var(--r) * 0.7)); }
	}
	@keyframes omega-cue {

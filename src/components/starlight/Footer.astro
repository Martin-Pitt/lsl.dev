---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { Icon } from '@astrojs/starlight/components';
// Starlight 0.42 Footer plus the site-wide unofficial notice and source attribution.
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	<div class="site-notice">
		<p>
			Unofficial documentation. lsl.dev is not affiliated with or endorsed by
			Linden Lab. Second Life and Linden Lab are trademarks of Linden Research, Inc.
		</p>
		<p>
			Combines the <a href="https://wiki.secondlife.com/wiki/LSL_Portal">official LSL Wiki</a>{' '}
			(prose, caveats and examples; <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>)
			with <a href="https://github.com/secondlife/lsl-definitions">LSL Definitions</a> (signatures,
			parameters and metadata; MIT). <a href="/about/">About these docs</a>
		</p>
	</div>

</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		.site-notice {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}
		.site-notice p {
			margin: 0;
		}
		.site-notice a {
			color: var(--sl-color-gray-2);
		}

		.kudos {
			align-items: center;
			gap: 0.5em;
			margin: 1.5rem auto;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
		}
		.kudos:hover {
			color: var(--sl-color-white);
		}
	}

	@layer starlight.components {
		.kudos :global(svg) {
			color: var(--sl-color-orange);
		}
	}
</style>

---
/**
 * Site-wide page title (Starlight PageTitle override), as on the original lsl.dev: the h1, then
 * breadcrumbs under it, then one wrapping row of chips (constant groups, categories, feature
 * areas, sibling feature pages). Crumbs and chips come from src/lib/page-nav.ts. No crumbs on
 * the homepage or top-level index pages.
 */
const PAGE_TITLE_ID = '_top'; // Starlight's PAGE_TITLE_ID (not exported)
import { getCollection } from 'astro:content';
import { pageNav } from '../../lib/page-nav';
const route = Astro.locals.starlightRoute;
const title = route.entry.data.title;
const path = Astro.url.pathname;
let siblings: { label: string; href: string }[] = [];
const feature = path.match(/^\/features\/([^/]+)\/[^/]+\/$/);
if (feature) {
	const docs = await getCollection('docs', e => e.id === `features/${feature[1]}` || e.id.startsWith(`features/${feature[1]}/`));
	siblings = docs.sort((a, b) => a.id.length - b.id.length || a.data.title.localeCompare(b.data.title)).map(e => ({ label: e.data.title, href: `/${e.id}/` }));
}
const { crumbs, chips } = pageNav(path, title, siblings);
const chevron = '<svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><polyline points="9 18 15 12 9 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<h1 id={PAGE_TITLE_ID}>{title}</h1>
{crumbs.length > 1 && (
	<nav class="page-crumbs" aria-label="Breadcrumb">
		<ol>{crumbs.map((c, i) => (
			<li>{i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}{i < crumbs.length - 1 && <Fragment set:html={chevron} />}</li>
		))}</ol>
	</nav>
)}
{chips.length > 0 && (
	<ul class="page-chips" aria-label="Related">
		{chips.map(c => <li><a class={`page-chip page-chip-${c.kind.toLowerCase()}`} href={c.href}><span class="sr-only">{c.kind}: </span>{c.label}</a></li>)}
	</ul>
)}
<style>
	@layer starlight.core {
		h1 { margin-top: 1rem; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 600; color: var(--sl-color-white); }
	}
	.page-crumbs { margin-top: .5rem; font-size: var(--sl-text-sm); }
	.page-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: .15rem .3rem; margin: 0; padding: 0; list-style: none; }
	.page-crumbs li { display: inline-flex; align-items: center; gap: .3rem; min-width: 0; }
	.page-crumbs a { font-weight: 500; color: var(--sl-color-white); text-decoration: none; }
	.page-crumbs a:hover { color: var(--sl-color-text-accent); }
	.page-crumbs [aria-current] { color: var(--sl-color-gray-3); }
	.page-crumbs :global(svg) { color: var(--sl-color-gray-4); flex: none; }
	.page-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: .75rem 0 0; padding: 0; list-style: none; }
	.page-chip { display: inline-flex; align-items: center; min-height: 1.75rem; padding: .1rem .7rem; border: 1px solid var(--sl-color-hairline); border-radius: 2rem; font-size: var(--sl-text-xs); line-height: 1.4; color: var(--sl-color-gray-2); text-decoration: none; }
	.page-chip:hover { color: var(--sl-color-white); border-color: var(--sl-color-text-accent); }
	.page-chip-feature { border-color: var(--sl-color-accent); color: var(--sl-color-text-accent); }
	.page-chip-group { border-style: dashed; border-color: var(--sl-color-gray-3); color: var(--sl-color-white); font-family: var(--__sl-font-mono); }
	.page-chip-page { background: var(--sl-color-gray-6); border-color: transparent; }
	@media (pointer: coarse) { .page-chip { min-height: 2.75rem; padding-inline: .9rem; } }
</style>

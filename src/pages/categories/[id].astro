---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid } from '@astrojs/starlight/components';
import { inlineLsl, enhanceText } from '../../lib/inline-lsl';
import CatalogList from '../../components/reference/CatalogList.astro';
import { catalog, apiMap, apiHref } from '../../lib/catalog';
import { featurePageByCategory, featureHref } from '../../lib/features';
import { categoryPageIds } from '../../lib/categories';
import guides from '../../data/topic-guides.json';
// Single-member categories get no page; every link points at the member instead (src/lib/categories.ts).
export function getStaticPaths(){return catalog.categories.filter(category=>categoryPageIds.includes(category.id)).map(category=>({params:{id:category.id},props:{category}}));}
const {category}=Astro.props;
const guide=(guides as any)[category.id];
// Each entry shows its highlighted signature (e.g. `list llGetExperienceDetails(key experience_id)`) and a
// description with API names highlighted and linked; the signature sits inside the entry's link, so it has no links itself.
const items=await Promise.all([...category.functions,...category.events,...category.constants].map(name=>apiMap.get(name)).filter(Boolean).map(async e=>({
	title:e!.name, description:e!.description, href:apiHref(e!.kind,e!.name), kind:e!.kind,
	titleHtml: e!.signature ? await inlineLsl(e!.signature,{link:false}) : undefined,
	descriptionHtml: e!.description ? await enhanceText(e!.description,{self:e!.name, params:(e!.parameters||[]).map((p:any)=>p.name)}) : undefined,
})));
// Task cards are titled with the highlighted call (the task wording is the fallback); the whole card is the link, so the code has no links of its own.
const tasks=await Promise.all((guide?.tasks || []).map(async (task:any)=>{
	const entry=task.function ? apiMap.get(task.function) : undefined;
	return {...task, href: task.href || apiHref('function',task.function), signature: entry?.signature ? await inlineLsl(entry.signature,{link:false}) : undefined, descriptionHtml: task.description ? await enhanceText(task.description,{link:false, self:entry?.name, params:(entry?.parameters||[]).map((p:any)=>p.name)}) : undefined};
}));
const feature=featurePageByCategory.get(category.id);
---
<StarlightPage frontmatter={{title:category.label,description:guide?.summary || `LSL ${category.label.toLowerCase()} functions, events, and constants.`,editUrl:false}}>
<p>{guide?.summary || `Explore the functions and events for ${category.label.toLowerCase()}. Follow an entry for its parameters, examples, and technical constraints.`}</p>
{feature && <p>Feature: <a href={featureHref(feature.id)}>{feature.title}</a></p>}
{tasks.length>0 && <><h2 id="start-here">What do you want to do?</h2><CardGrid>{tasks.map((task:any)=>(
	<a class="task-card" href={task.href}>
		{task.signature ? <span class="title sig" set:html={task.signature}/> : <span class="title">{task.label}</span>}
		{task.descriptionHtml && <span class="desc" set:html={task.descriptionHtml}/>}
	</a>
))}</CardGrid></>}
<h2 id="reference">Reference</h2><CatalogList items={items} label="topic entries"/>
</StarlightPage>
<style>
	.task-card { display: flex; flex-direction: column; gap: .375rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; text-decoration: none; color: var(--sl-color-gray-2); box-shadow: var(--sl-shadow-sm); }
	.task-card:hover { border-color: var(--sl-color-gray-2); background: var(--sl-color-gray-7, var(--sl-color-gray-6)); }
	.task-card:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
	.title { font-weight: 600; font-size: var(--sl-text-lg); color: var(--sl-color-white); }
	.sig :global(code) { font-size: var(--sl-text-sm); font-weight: 600; white-space: normal; background: none; padding: 0; }
	.desc { font-size: var(--sl-text-sm); }
	.desc :global(code) { font-size: .9em; }
</style>

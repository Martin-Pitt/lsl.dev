---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CatalogList from '../../components/reference/CatalogList.astro';
import { categoryMap } from '../../lib/catalog';
import { featurePages as features } from '../../lib/features';
import { categoryLink } from '../../lib/categories';
// Same dense layout as the constants page: one block per feature, its categories as entries with their member counts.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const groups = features.filter(f => f.categories.length > 0).map(f => ({
	id: f.id, label: f.title,
	items: f.categories.map(id => categoryMap.get(id)!).map(cat => {
		const link = categoryLink(cat.id), n = cat.functions.length + cat.events.length;
		return { title: link.label, href: link.href, description: `${cat.functions.length} functions · ${cat.events.length} events`, code: `<span class="cat">${esc(link.label)} <small>${n}</small></span>` };
	}),
}));
---
<StarlightPage frontmatter={{ title: 'Categories', description: 'LSL Definitions categories, arranged by feature.', editUrl: false }}>
<CatalogList groups={groups} label="categories" />
</StarlightPage>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { catalog, categoryHref } from '../../lib/catalog';
---
<StarlightPage frontmatter={{title:'Explore by topic',description:'Find the LSL tools for what you want to build.',editUrl:false}}>
<p>Start with a task or a part of the world. Each topic brings its functions, events, and related constants together, with the full technical details one link away.</p>
<CardGrid>{catalog.categories.map(c=><LinkCard title={c.label} href={categoryHref(c.id)} description={`${c.functions.length} functions · ${c.events.length} events · ${c.constants.length} constants`}/>)}</CardGrid>
</StarlightPage>

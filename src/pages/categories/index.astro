---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { features, categoryMap, categoryHref, featureHref } from '../../lib/catalog';
---
<StarlightPage frontmatter={{ title: 'Categories', description: 'LSL Definitions categories, arranged by feature.', editUrl: false }}>
	<p>Each category page lists every function and event in that category from LSL Definitions. Categories are arranged under the <a href="/features/">feature</a> they belong to.</p>
	{features.filter(c => c.categories.length > 0).map(c => (
		<>
			<h2 id={c.id}><a href={featureHref(c.id)}>{c.title}</a></h2>
			<CardGrid>
				{c.categories.map(id => categoryMap.get(id)!).map(cat => <LinkCard title={cat.label} href={categoryHref(cat.id)} description={`${cat.functions.length} functions · ${cat.events.length} events`} />)}
			</CardGrid>
		</>
	))}
</StarlightPage>

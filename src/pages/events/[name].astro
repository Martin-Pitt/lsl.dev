---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ApiDetail from '../../components/reference/ApiDetail.astro';
import { catalog } from '../../lib/catalog';
import { apiHeadings, breadcrumbBanner } from '../../lib/api-page';
export function getStaticPaths() { return catalog.events.map(entry=>({params:{name:entry.name},props:{entry}})); }
const { entry } = Astro.props;
const headings = apiHeadings(entry);
---
<StarlightPage frontmatter={{title:entry.name,description:entry.description.slice(0,160),editUrl:false,lastUpdated:false,banner:{content:breadcrumbBanner(entry)}}} headings={headings}>
<ApiDetail entry={entry}/>
</StarlightPage>

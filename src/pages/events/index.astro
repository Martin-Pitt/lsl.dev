---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CatalogList from '../../components/reference/CatalogList.astro';
import { apiRows } from '../../components/reference/catalog-items';
import { catalog } from '../../lib/catalog';
const items = await apiRows(catalog.events);
---
<StarlightPage frontmatter={{title:'Events',description:'Browse the current LSL events reference.',editUrl:false}}>
<CatalogList items={items} label="events" filterCategories={catalog.categories} az/>
</StarlightPage>

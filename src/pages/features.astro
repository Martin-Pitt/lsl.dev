---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {CardGrid,LinkCard} from '@astrojs/starlight/components';
import {catalog,categoryHref} from '../lib/catalog';
---
<StarlightPage frontmatter={{title:'LSL features',editUrl:false}}><p>Find the building blocks for your next project.</p><CardGrid>{catalog.categories.map(c=><LinkCard title={c.label} href={categoryHref(c.id)}/>)}</CardGrid></StarlightPage>

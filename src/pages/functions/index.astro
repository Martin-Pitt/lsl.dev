---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CatalogList from '../../components/reference/CatalogList.astro';
import { apiRows } from '../../components/reference/catalog-items';
import { catalog } from '../../lib/catalog';
// One row per function: highlighted signature, one-line description, flag chips. The A–Z bar's anchors
// (#from-a … #from-z, first function of each letter ignoring the ll prefix) are linked from the landing page.
const items = await apiRows(catalog.functions);
---
<StarlightPage frontmatter={{title:'Functions',description:'Browse the current LSL functions reference.',editUrl:false}}>
<p>Find LSL functions by name, purpose, or topic. Signatures and descriptions follow the current definitions; deprecated and private entries are excluded. Hover a signature for its description; the badges are explained above the list, and selecting one shows only those functions.</p>
<CatalogList items={items} label="functions" filterCategories={catalog.categories} az/>
</StarlightPage>

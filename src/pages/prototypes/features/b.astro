---
// PROTOTYPE B: standalone task-first page, the shared TaskList plus a compact A-Z
// (temporary; docs/prototypes/features-index.md).
import ProtoShell from '../../../components/prototypes/ProtoShell.astro';
import TaskList from '../../../components/features/TaskList.astro';
import { alphabetical, featureHref } from '../../../lib/features-overview';
---
<ProtoShell title="Features by task" summary="Common tasks with the API and feature that do the job, then every feature A-Z.">
	<TaskList />
	<section aria-labelledby="az">
		<h2 id="az">All features A–Z</h2>
		<ul class="az">
			{alphabetical.map(f => <li><a href={featureHref(f.id)} title={f.description}>{f.title}</a></li>)}
		</ul>
	</section>
</ProtoShell>
<style>
	.az { list-style: none; padding: 0; margin: .5rem 0 0; columns: 4 9rem; column-gap: 1.5rem; }
	.az li { margin: 0; break-inside: avoid; }
	.az a { display: block; padding: .25rem 0; }
</style>

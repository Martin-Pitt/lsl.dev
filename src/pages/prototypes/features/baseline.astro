---
// PROTOTYPE reference: the previous Features Overview (A-Z LinkCards), kept for comparison
// (temporary; docs/prototypes/features-index.md).
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import ProtoShell from '../../../components/prototypes/ProtoShell.astro';
import { featurePages, featureHref } from '../../../lib/features';
---
<ProtoShell title="Features Overview (previous)" summary="The previous Features Overview: one card per feature, A-Z.">
	<p>Each feature page explains an area of Second Life scripting at a high level and links to the functions, events, constant groups and articles for it. Follow a link for signatures, parameters, caveats and examples.</p>
	<CardGrid>
		{featurePages.map(f => <LinkCard title={f.title} description={f.description} href={featureHref(f.id)} />)}
	</CardGrid>
</ProtoShell>

---
// PROTOTYPE C: icon dashboard, most-used first, quick filter (temporary; docs/prototypes/features-index.md).
import { Icon } from '@astrojs/starlight/components';
import ProtoShell from '../../../components/prototypes/ProtoShell.astro';
import { byUsage, icons, purpose, keyApis, featureHref, apiHref } from '../../../lib/prototypes/features-index';
const top = 6;
---
<ProtoShell variant="c" title="Dashboard" summary="Large icon tiles, most-used features first, with a filter box that also matches API names.">
	<div class="proto">
		<div class="filter">
			<label for="feature-filter">Filter features or APIs</label>
			<input id="feature-filter" type="search" placeholder="e.g. sound, llDialog, rez" autocomplete="off" aria-describedby="filter-status" />
			<p id="filter-status" role="status" aria-live="polite">{byUsage.length} features</p>
		</div>
		{[['popular', 'Most used', byUsage.slice(0, top)], ['more', 'More features', byUsage.slice(top)]].map(([id, heading, list]: any) => (
			<section aria-labelledby={id} data-section>
				<h2 id={id}>{heading}</h2>
				<ul class="tiles">
					{list.map((f: any) => (
						<li class="tile" data-search={[f.title, f.description, ...f.items].join(' ').toLowerCase()}>
							<a class="head" href={featureHref(f.id)}>
								<span class="icon"><Icon name={icons[f.id] as any} size="1.5rem" /></span>
								<span><span class="t">{f.title}</span><span class="p">{purpose[f.id]}</span></span>
							</a>
							<ul class="apis" aria-label={`Key ${f.title} APIs`}>
								{keyApis(f, 4).map(a => <li><a href={apiHref(a)}><code>{a}</code></a></li>)}
							</ul>
						</li>
					))}
				</ul>
			</section>
		))}
		<p class="empty" hidden>No feature matches. Try the site search for individual APIs.</p>
	</div>
</ProtoShell>
<script>
	const input = document.getElementById('feature-filter') as HTMLInputElement | null;
	const status = document.getElementById('filter-status')!;
	const tiles = [...document.querySelectorAll<HTMLElement>('.tile')];
	input?.addEventListener('input', () => {
		const q = input.value.trim().toLowerCase();
		let n = 0;
		for (const t of tiles) { const hit = !q || t.dataset.search!.includes(q); t.hidden = !hit; if (hit) n++; }
		document.querySelectorAll<HTMLElement>('[data-section]').forEach(s => { s.hidden = !s.querySelector('.tile:not([hidden])'); });
		(document.querySelector('.empty') as HTMLElement).hidden = n > 0;
		status.textContent = q ? `${n} of ${tiles.length} features match` : `${tiles.length} features`;
	});
</script>
<style>
	.filter { margin-top: 1rem; }
	.filter label { display: block; font-weight: 600; }
	.filter input { width: 100%; max-width: 28rem; margin-top: .375rem; padding: .625rem .75rem; font: inherit; border-radius: .5rem; border: 1px solid var(--sl-color-gray-4); background: var(--sl-color-black); color: var(--sl-color-white); }
	.filter input:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 1px; }
	#filter-status { margin: .25rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.tiles { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
	.tile { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; padding: .75rem; display: flex; flex-direction: column; gap: .5rem; }
	.tile:hover { border-color: var(--sl-color-accent); }
	.head { display: flex; gap: .75rem; align-items: center; text-decoration: none; color: inherit; min-height: 3rem; }
	.icon { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: .625rem; background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); }
	.t { display: block; font-weight: 600; font-size: var(--sl-text-lg); color: var(--sl-color-white); }
	.p { display: block; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.35; }
	.apis { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .25rem; }
	.apis li { margin: 0; }
	.apis a { display: inline-flex; min-height: 1.75rem; align-items: center; text-decoration: none; }
	.apis code { font-size: var(--sl-text-xs); }
	.empty { margin-top: 1rem; }
</style>

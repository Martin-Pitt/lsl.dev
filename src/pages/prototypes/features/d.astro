---
// PROTOTYPE D: hybrid. "Start here" path + filter + goal groups with expandable key APIs
// (temporary; docs/prototypes/features-index.md).
import ProtoShell from '../../../components/prototypes/ProtoShell.astro';
import { byGoal, byTask, purpose, keyApis, featureHref, apiHref, featurePageMap } from '../../../lib/prototypes/features-index';
const start = ['events', 'input', 'communications'].map(id => featurePageMap.get(id)!);
const quick = byTask.slice(0, 6);
---
<ProtoShell variant="d" title="Search + groups" summary="One highlighted starting path, a filter, and goal groups whose rows expand to show key APIs.">
	<div class="proto">
		<section class="start" aria-labelledby="start">
			<h2 id="start">New to LSL? Start here</h2>
			<ol>
				{start.map((f, i) => <li><a href={featureHref(f.id)}><span class="n" aria-hidden="true">{i + 1}</span><span><strong>{f.title}</strong><span class="p">{purpose[f.id]}</span></span></a></li>)}
			</ol>
		</section>
		<div class="bar">
			<label for="d-filter" class="sr-only">Filter features or APIs</label>
			<input id="d-filter" type="search" placeholder="Filter 23 features or their APIs…" autocomplete="off" aria-describedby="d-status" />
			<p id="d-status" role="status" aria-live="polite" class="sr-only"></p>
			<p class="quick">Popular: {quick.map((t, i) => <>{i > 0 && ' · '}<a href={featureHref(t.page.id)}>{t.task}</a></>)}</p>
		</div>
		<div class="groups">
			{byGoal.map(g => (
				<section class="group" aria-labelledby={`d-${g.id}`} data-group>
					<h2 id={`d-${g.id}`}>{g.title}</h2>
					<ul>
						{g.pages.map(f => (
							<li data-search={[f.title, f.description, ...f.items].join(' ').toLowerCase()}>
								<a class="row" href={featureHref(f.id)}><span class="t">{f.title}</span><span class="p">{purpose[f.id]}</span></a>
								<details>
									<summary><span class="sr-only">{f.title}: </span>Key APIs</summary>
									<ul class="apis">{keyApis(f, 5).map(a => <li><a href={apiHref(a)}><code>{a}</code></a></li>)}</ul>
								</details>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</div>
</ProtoShell>
<script>
	const input = document.getElementById('d-filter') as HTMLInputElement | null;
	const status = document.getElementById('d-status')!;
	const rows = [...document.querySelectorAll<HTMLElement>('[data-search]')];
	input?.addEventListener('input', () => {
		const q = input.value.trim().toLowerCase();
		let n = 0;
		for (const r of rows) { const hit = !q || r.dataset.search!.includes(q); r.hidden = !hit; if (hit) n++; }
		document.querySelectorAll<HTMLElement>('[data-group]').forEach(g => { g.hidden = !g.querySelector('[data-search]:not([hidden])'); });
		status.textContent = q ? `${n} features match` : '';
	});
</script>
<style>
	.start { margin-top: 1rem; padding: 1rem; border-radius: .75rem; background: var(--sl-color-accent-low); border: 1px solid var(--sl-color-accent); }
	.start h2 { margin: 0; font-size: var(--sl-text-h4); }
	.start ol { list-style: none; padding: 0; margin: .75rem 0 0; display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
	.start li { margin: 0; }
	.start a { display: flex; gap: .625rem; align-items: center; padding: .5rem; border-radius: .5rem; text-decoration: none; color: var(--sl-color-white); background: var(--sl-color-bg); min-height: 3rem; }
	.n { flex: none; display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; }
	.bar { margin-top: 1.25rem; }
	.bar input { width: 100%; padding: .625rem .75rem; font: inherit; border-radius: .5rem; border: 1px solid var(--sl-color-gray-4); background: var(--sl-color-black); color: var(--sl-color-white); }
	.bar input:focus-visible, .proto a:focus-visible, summary:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
	.quick { margin: .5rem 0 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	.groups { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); margin-top: 1.25rem; }
	.group { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; padding: .75rem 1rem; }
	.group h2 { margin: 0 0 .25rem; font-size: var(--sl-text-base); text-transform: uppercase; letter-spacing: .04em; color: var(--sl-color-gray-3); }
	.group > ul { list-style: none; padding: 0; margin: 0; }
	.group > ul > li { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; border-top: 1px solid var(--sl-color-hairline-light, var(--sl-color-gray-6)); padding: .375rem 0; }
	.group > ul > li:first-child { border-top: 0; }
	.row { display: block; text-decoration: none; color: inherit; padding: .25rem 0; }
	.t { display: block; font-weight: 600; color: var(--sl-color-text-accent); }
	.p { display: block; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); font-weight: 400; }
	details[open] { grid-column: 1 / -1; }
	details[open] summary { text-align: right; }
	summary { cursor: pointer; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); padding: .5rem 0 .5rem .5rem; min-height: 2rem; }
	.apis { grid-column: 1 / -1; list-style: none; padding: 0 0 .25rem; margin: 0; display: flex; flex-wrap: wrap; gap: .25rem .5rem; }
	.apis li { margin: 0; }
	.apis a { display: inline-flex; min-height: 1.75rem; align-items: center; }
	.apis code { font-size: var(--sl-text-xs); }
</style>

---
// PROTOTYPE E: features overview modelled on the LSL Portal's "LSL Features by category" column
// (temporary; docs/prototypes/features-index.md).
import ProtoShell from '../../../components/prototypes/ProtoShell.astro';
import PortalTopics from '../../../components/prototypes/PortalTopics.astro';
---
<ProtoShell title="Features by category" summary="Every LSL topic in two views, A-Z and as a topic tree, linked to features, categories and constant groups.">
	<p class="legend">
		<strong>Bold</strong> links open a feature page, plain links a category, <code>Code</code> links a constant group.
	</p>
	<PortalTopics />
</ProtoShell>
<style>
	.legend { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
	.legend code { font-size: var(--sl-text-xs); }
</style>

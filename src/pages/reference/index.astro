---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { catalog, categoryMap } from '../../lib/catalog';
import { featurePages as features, featureHref } from '../../lib/features';
import { categoryLink } from '../../lib/categories';
---
<StarlightPage frontmatter={{ title: 'Reference', description: 'LSL functions, events, constants, types and flow control.', editUrl: false }}>
	<p>Signatures, parameters and metadata come from LSL Definitions; descriptions, caveats and examples come from the LSL Wiki. Deprecated and private entries are left out. A definition does not guarantee availability in every region.</p>
	<CardGrid>
		<LinkCard title="Functions" description={`All ${catalog.functions.length} functions, filterable by name and category.`} href="/functions/" />
		<LinkCard title="Events" description={`All ${catalog.events.length} events.`} href="/events/" />
		<LinkCard title="Constants" description={`All ${catalog.constants.length.toLocaleString('en')} constants, filterable by group.`} href="/constants/" />
		<LinkCard title="Constant groups" description="Constants by enum or flag set." href="/constants/groups/" />
		<LinkCard title="Types" description={`The ${catalog.types.length} LSL value types.`} href="/fundamentals/types/" />
		<LinkCard title="Flow control" description="States, branches, loops and returns." href="/fundamentals/flow-control/" />
		<LinkCard title="Limits" description="Second Life's numerical limits: scripting, building, chat, land, inventory and more." href="/reference/limits/" />
		<LinkCard title="Viewer URIs" description="Every secondlife:// and secondlife:///app/ URI form, with syntax and parameters." href="/reference/viewer-uris/" />
	</CardGrid>
	<h2 id="categories">Categories</h2>
	<p>The {catalog.categories.length} categories from LSL Definitions, arranged by feature.</p>
	<dl class="category-map">
		{features.filter(c => c.categories.length > 0).map(c => (
			<div>
				<dt><a href={featureHref(c.id)}>{c.title}</a></dt>
				<dd>{c.categories.map((id, i) => <>{i > 0 && ' · '}<a href={categoryLink(id).href}>{categoryLink(id).label}</a></>)}</dd>
			</div>
		))}
	</dl>
</StarlightPage>
<style>
	.category-map > div { display: grid; grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); gap: .25rem 1rem; padding: .4rem 0; border-bottom: 1px solid var(--sl-color-hairline); }
	.category-map dd { margin: 0; font-size: var(--sl-text-sm); }
	@media (max-width: 40rem) { .category-map > div { grid-template-columns: 1fr; } }
</style>
